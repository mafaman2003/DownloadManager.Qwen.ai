<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DownloadManager.Views.AddDownloadWindow"
        Title="New Download"
        Width="640" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer MaxHeight="720">
        <StackPanel Margin="20" Spacing="13">
            <TextBlock Text="Add New Download" FontSize="18" FontWeight="SemiBold"/>

            <StackPanel Spacing="5">
                <TextBlock Text="Download URL" Classes="sub"/>
                <TextBox x:Name="UrlBox" Watermark="https://example.com/file.zip" Height="34"/>
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="Save to folder" Classes="sub"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="OnBrowse" Content="Browse…"
                            Margin="8,0,0,0" Padding="10,6"/>
                    <TextBox x:Name="DirBox" Height="34"/>
                </DockPanel>
            </StackPanel>

            <Grid ColumnDefinitions="*,140">
                <StackPanel Spacing="5" Margin="0,0,12,0">
                    <TextBlock Text="File name (optional)" Classes="sub"/>
                    <TextBox x:Name="NameBox" Watermark="auto-detected" Height="34"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Text="Segments" Classes="sub"/>
                    <NumericUpDown x:Name="SegPick" Minimum="1" Maximum="32" Increment="1" Height="34"/>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="5">
                <TextBlock Text="Mirror URLs — one per line (optional)" Classes="sub"/>
                <TextBox x:Name="MirrorsBox" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="58" Watermark="https://mirror1.example.com/file.zip"/>
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="Checksum verification (optional)" Classes="sub"/>
                <DockPanel>
                    <ComboBox x:Name="AlgoPick" DockPanel.Dock="Left" Width="120" Height="34"/>
                    <TextBox x:Name="HashBox" Margin="8,0,0,0" Height="34"
                             Watermark="expected hash, e.g. 9f86d081…"/>
                </DockPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
                <Button Content="Cancel" Click="OnCancel" Padding="14,7" IsCancel="True"/>
                <Button Classes="accent" Content="Add Download" Click="OnAdd" Padding="14,7" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>