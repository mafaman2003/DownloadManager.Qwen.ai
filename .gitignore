```gitignore
# Build artifacts
bin/
obj/
*.exe
*.dll
*.so
*.dylib
*.pdb
*.ilk
*.exp
*.lib
*.o
*.obj
*.a
*.out

# Dependencies
packages/
*.nupkg
**/packages/

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
desktop.ini

# Visual Studio files
.vs/
*.user
*.userosscache
*.suo
*.csproj.user
*.vbproj.user
*.vcxproj.user

# Rider IDE
.idea/
*.sln.iml

# Temporary files
*.tmp
*.temp
*.bak
*.cache
*.cachedb
*.db-journal

# Environment variables
.env
.env.local
.env.*
!.env.example

# Coverage reports
coverage/
*.cover
*.gcda
*.gcno
htmlcov/

# Testing
*.test
*.tests
test-results/
TestResults/

# Compression artifacts
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.gz
*.bz2
*.xz
*.7z
*.rar
*.jar
*.war
*.par
*.nar
*.ear
*.sar
*.ipa

# Generated files
Generated_Code/  # Add generated code folder(s) here
*_generated.*   # Add files generated by tools here
```