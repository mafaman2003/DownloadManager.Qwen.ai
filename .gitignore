```gitignore
# Build artifacts
*.dll
*.exe
*.pdb
*.nupkg
*.snupkg
bin/
obj/
out/

# Dependencies
packages/
node_modules/
vendor/

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Editor files
.vs/
.idea/
*.userprefs
*.user
*.suo
*.userosscache
*.sln.docstates

# Configuration specific to the project
*.user-settings
*.localsettings
```